[
	{
		"名称":"全部"
		"类型":0      /*  排序文件类型时,按数值排序,255是标记目录,所以,这里不能写255  */
	}
	{
		"名称":"文件夹"
		"类型":255
		"后缀":"" /* 不能有后缀 */
	}
	{
		"名称":"快捷方式"
		"类型":100
		"后缀":"LNK"
	}
	{
		"名称":"程序"
		"类型":99
		"后缀":"EXE,BAT,MSI"
	}
	{
		"名称":"音频"
		"类型":98
		"后缀":"AAC,APE,CDA,CUE,FLAC,M4A,MP3,NCM,OGG,WAV,WMA"
	}
	{
		"名称":"视频"
		"类型":97
		"后缀":"AVI,MP4,MOV,WMV,FLV,MKV,RMVB,3GP,ASF,M4V,VOB,M2TS,TS,WEBM,F4V,M4P,MPEG,MPG,DIVX,XVID,M2T,M2V,MTS,MPV,OGV,RM,QT,H3D,NSV"
	}
	{
		"名称":"图片"
		"类型":96
		"后缀":"BMP,GIF,JPG,JPEG,PNG,ICO,TIFF,PSD,SVG,WEBP,PCX,TGA,EXIF,FPX,CDR,PCD,DXF,UFO,EPS,AI,HDRI,RAW,WMF,FLIC,EMF"
	}
	{
		"名称":"文档"
		"类型":80
		"后缀":"txt,html,cpp,ini,xml,csc"
	}
	{
		"名称":"办公"
		"类型":79
		"后缀":"doc,csv,pdf,pptx,ppt,docx,doc,xlsx,xls,et,ett,xlt,xlsm,dbf,prn"
	}
	{
		"名称":"压缩包"
		"类型":60
		"后缀":"RAR,ZIP,ZIPX,7Z,ISO,IMG,ISZ,CAB,ARJ,ACE,ALZ,UUE,TAR,GZ,GZIP,TGZ,TPZ,BZIP2,BZ2,BZ,TBZ,XPI,WIM,SWM,XAR,DEB,DMG,HFS,CPIO,LZMA,LZMA86,SPLIT,001"
	}
]

/* 0=全部文件 */
/* 255=目录   */
/* 其它数值类型随便填写 */
/* 类型只能1~254
/* 可以自己增加后缀, 增加筛选,前提是,类型没有重复的,类型也不能为0或者255 内部用来标记是否为目录 */
/* 需要注意的是, 如果对配置文件进行修改, 那么就必须要重新遍历所有文件.*/